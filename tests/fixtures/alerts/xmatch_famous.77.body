{"metadata":[{"name":"PGC","description":"[2/5061296] Number in Principal Galaxies Catalog for group member","datatype":"INT","ucd":"meta.id"},{"name":"Nest","description":"[100001/220041] Group (nest) identification number (G1)","datatype":"INT","ucd":"meta.id;meta.main"},{"name":"PGC1","description":"[5/5061293] Number in Principal Galaxies Catalog for brightest member in group","datatype":"INT","ucd":"meta.id"},{"name":"Nmb","description":"[1/197] Number of members from the 2MASS 11.75 catalog (Huchra et al. 2012, cat. J/ApJS/199/26)","datatype":"SHORT","ucd":"meta.number"},{"name":"sigV","description":"[0/3403] Line Of Sight (LOS) bi-weight velocity dispersion of group members {sigma}_V_ (1)","datatype":"SHORT","unit":"km/s","ucd":"phys.veloc.dispersion"},{"name":"R2t","description":"[0/5.225] Projected radius of second turnaround R_2t_ (G5)","datatype":"DOUBLE","unit":"Mpc","ucd":"phys.size.radius"},{"name":"Ngal","description":"Number of galaxies in this group (link to Table 2)","datatype":"SHORT","ucd":"meta.number"},{"name":"DMzp","description":"[20.36/39.44] Group, weighted average distance modulus, TRGB, cepheid and maser calibrators (1)","datatype":"DOUBLE","unit":"mag","ucd":"phot.mag.distMod;stat.mean"},{"name":"e_DMzp","description":"[0.008/2.11] Uncertainty in DMzp","datatype":"DOUBLE","unit":"mag","ucd":"stat.error;phot.mag.distMod"},{"name":"V3k","description":"[-617/32575] Group velocity, relative to cosmic background","datatype":"SHORT","unit":"km/s","ucd":"phys.veloc;pos.cmb"},{"name":"_RA_icrs","description":"Right ascension (ICRS) (computed by VizieR, not part of the original data)","datatype":"DOUBLE","unit":"deg","ucd":"pos.eq.ra"},{"name":"_DE_icrs","description":"Declination (ICRS) (computed by VizieR, not part of the original data)","datatype":"DOUBLE","unit":"deg","ucd":"pos.eq.dec"},{"name":"match_dist","datatype":"DOUBLE"}],"data":[[12219,200001,12429,180,962,1.897,51,34.185,0.036,5208,49.3635,41.4052,9.729235647647688E-5]]}