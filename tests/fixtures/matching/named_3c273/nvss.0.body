<?xml version="1.0"?>
<VOTABLE xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.4">
 <RESOURCE type="results">
  <INFO name="QUERY_STATUS" value="OK">No errors detected in query preprocessing</INFO>
  <TABLE>
   <DESCRIPTION>Query result for:&#xA;SELECT TOP 201 name, ra, dec, flux_20_cm, flux_20_cm_error, ra_error, dec_error, major_axis, minor_axis, position_angle, pol_flux, DISTANCE(POINT(&apos;ICRS&apos;, ra, dec), POINT(&apos;ICRS&apos;, 187.277915940, 2.052388230)) AS match_dist FROM nvss WHERE 1 = CONTAINS(POINT(&apos;ICRS&apos;, ra, dec), CIRCLE(&apos;ICRS&apos;, 187.277915940, 2.052388230, 0.0013888889)) ORDER BY match_dist ASC</DESCRIPTION>
   <FIELD datatype="char" arraysize="*" ucd="meta.id;meta.main" name="name">
    <DESCRIPTION>Catalog Designation</DESCRIPTION>
   </FIELD>
   <FIELD unit="deg" datatype="double" ucd="pos.eq.ra;meta.main" precision="F5" name="ra">
    <DESCRIPTION>Right Ascension</DESCRIPTION>
   </FIELD>
   <FIELD unit="deg" datatype="double" ucd="pos.eq.dec;meta.main" precision="F5" name="dec">
    <DESCRIPTION>Declination</DESCRIPTION>
   </FIELD>
   <FIELD unit="mJy" datatype="double" ucd="phot.flux.density;em.radio" precision="F1" name="flux_20_cm" width="6">
    <DESCRIPTION>Integrated 1.4-GHz Flux Density (mJy)</DESCRIPTION>
   </FIELD>
   <FIELD unit="mJy" datatype="double" ucd="stat.error;phot.flux.density;em.radio" precision="F1" name="flux_20_cm_error" width="5">
    <DESCRIPTION>RMS Uncertainty in Flux Density at 20 cm</DESCRIPTION>
   </FIELD>
   <FIELD unit="s" datatype="double" ucd="stat.error;pos.eq.ra" precision="F2" name="ra_error" width="5">
    <DESCRIPTION>RMS Uncertainty in Right Ascension (s)</DESCRIPTION>
   </FIELD>
   <FIELD unit="arcsec" datatype="double" ucd="stat.error;pos.eq.dec" precision="F1" name="dec_error" width="4">
    <DESCRIPTION>RMS Uncertainty in Declination (arcsec)</DESCRIPTION>
   </FIELD>
   <FIELD unit="arcsec" datatype="double" ucd="phys.size.smajAxis" precision="F1" name="major_axis" width="5">
    <DESCRIPTION>Length of Fitted Major Axis of Radio Source (arcsec)</DESCRIPTION>
   </FIELD>
   <FIELD unit="arcsec" datatype="double" ucd="phys.size.sminAxis" precision="F1" name="minor_axis" width="5">
    <DESCRIPTION>Length of Minor Axis of Radio Source (arcsec)</DESCRIPTION>
   </FIELD>
   <FIELD unit="deg" datatype="double" ucd="pos.posAng" precision="F1" name="position_angle" width="5">
    <DESCRIPTION>Position Angle of the Fitted Major Axis (degree)</DESCRIPTION>
   </FIELD>
   <FIELD unit="mJy" datatype="double" ucd="phot.flux.density;phys.polarization" precision="F2" name="pol_flux" width="6">
    <DESCRIPTION>Integrated Linearly Polarized Flux Density (mJy)</DESCRIPTION>
   </FIELD>
   <FIELD datatype="double" name="match_dist"/>
   <DATA>
    <BINARY>
     <STREAM encoding="base64">

     </STREAM>
    </BINARY>
   </DATA>
  </TABLE>
 </RESOURCE>
</VOTABLE>
