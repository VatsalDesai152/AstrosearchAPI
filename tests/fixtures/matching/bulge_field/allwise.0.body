  <RESOURCE type="results">
    <INFO name="QUERY_STATUS" value="OK"/>
    <TABLE>
      <GROUP ID="group_allwise_p3as_psd_pos" name="pos" ucd="pos.eq" utype="">
        <DESCRIPTION>Position, determined using a profile-fitting measurement model that does not include motion</DESCRIPTION>
        <FIELDref ref="col_1"/>
        <FIELDref ref="col_2"/>
        <FIELDref ref="col_3"/>
        <FIELDref ref="col_4"/>
        <FIELDref ref="col_5"/>
      </GROUP>
      <FIELD name="designation" datatype="char" arraysize="*" ID="col_0" ucd="meta.id;meta.main">
        <DESCRIPTION>WISE source designation</DESCRIPTION>
      </FIELD>
      <FIELD name="ra" datatype="double" ID="col_1" irsa_format="11.7f" precision="F7" ucd="pos.eq.ra;meta.main" unit="deg">
        <DESCRIPTION>right ascension (J2000)</DESCRIPTION>
      </FIELD>
      <FIELD name="dec" datatype="double" ID="col_2" irsa_format="11.7f" precision="F7" ucd="pos.eq.dec;meta.main" unit="deg">
        <DESCRIPTION>declination (J2000)</DESCRIPTION>
      </FIELD>
      <FIELD name="sigra" datatype="double" ID="col_3" irsa_format="8.4f" precision="F4" ucd="pos.errorEllipse" unit="arcsec">
        <DESCRIPTION>uncertainty in RA</DESCRIPTION>
      </FIELD>
      <FIELD name="sigdec" datatype="double" ID="col_4" irsa_format="8.4f" precision="F4" ucd="pos.errorEllipse" unit="arcsec">
        <DESCRIPTION>uncertainty in DEC</DESCRIPTION>
      </FIELD>
      <FIELD name="sigradec" datatype="double" ID="col_5" irsa_format="9.4f" precision="F4" ucd="pos.errorEllipse" unit="arcsec">
        <DESCRIPTION>cross-term of RA and Dec uncertainties</DESCRIPTION>
      </FIELD>
      <FIELD name="w1mpro" datatype="float" ID="col_6" irsa_format="7.3f" precision="F3" ucd="phot.mag" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry magnitude, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="w1sigmpro" datatype="float" ID="col_7" irsa_format="5.3f" precision="F3" ucd="stat.error" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="w2mpro" datatype="float" ID="col_8" irsa_format="7.3f" precision="F3" ucd="phot.mag" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry magnitude, band 2</DESCRIPTION>
      </FIELD>
      <FIELD name="w2sigmpro" datatype="float" ID="col_9" irsa_format="5.3f" precision="F3" ucd="stat.error" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 2</DESCRIPTION>
      </FIELD>
      <FIELD name="w3mpro" datatype="float" ID="col_10" irsa_format="7.3f" precision="F3" ucd="phot.mag" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry magnitude, band 3</DESCRIPTION>
      </FIELD>
      <FIELD name="w3sigmpro" datatype="float" ID="col_11" irsa_format="5.3f" precision="F3" ucd="stat.error" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 3</DESCRIPTION>
      </FIELD>
      <FIELD name="w4mpro" datatype="float" ID="col_12" irsa_format="7.3f" precision="F3" ucd="phot.mag" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry magnitude, band 4</DESCRIPTION>
      </FIELD>
      <FIELD name="w4sigmpro" datatype="float" ID="col_13" irsa_format="5.3f" precision="F3" ucd="stat.error" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 4</DESCRIPTION>
      </FIELD>
      <FIELD name="cc_flags" datatype="char" arraysize="*" ID="col_14" ucd="meta.code">
        <DESCRIPTION>prioritized artifacts affecting the source in each band</DESCRIPTION>
      </FIELD>
      <FIELD name="ext_flg" datatype="long" ID="col_15" ucd="stat.probability">
        <DESCRIPTION>probability that source morphology is not consistent with single PSF</DESCRIPTION>
      </FIELD>
      <FIELD name="ph_qual" datatype="char" arraysize="*" ID="col_16" ucd="meta.code.qual">
        <DESCRIPTION>photometric quality of each band (A=highest, U=upper limit)</DESCRIPTION>
      </FIELD>
      <FIELD name="w1mjdmean" datatype="double" ID="col_17" irsa_format="14.8f" precision="F8" ucd="time.epoch">
        <DESCRIPTION>mean modified Julian Date of frame extractions, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="tmass_key" datatype="long" ID="col_18" ucd="meta.id.assoc">
        <DESCRIPTION>closest associated 2MASS All-Sky Release PSC key</DESCRIPTION>
      </FIELD>
      <FIELD name="match_dist" datatype="double" ID="col_19" irsa_format="%15.6f" unit="arcsec"/>
