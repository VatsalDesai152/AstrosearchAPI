{"metadata":[{"name":"Source","description":"The radio name of the source in the format &quot;ILTJHHMMSS.s+DDMMSS&quot;","datatype":"CHAR","arraysize":"22","ucd":"meta.id;meta.main"},{"name":"RAJ2000","description":"Right ascension (J2000)","datatype":"DOUBLE","unit":"deg","ucd":"pos.eq.ra;meta.main"},{"name":"DEJ2000","description":"Declination (J2000)","datatype":"DOUBLE","unit":"deg","ucd":"pos.eq.dec;meta.main"},{"name":"e_RAJ2000","description":"? Uncertainty in right ascension","datatype":"DOUBLE","unit":"arcsec","ucd":"stat.error;pos.eq.ra"},{"name":"e_DEJ2000","description":"? Uncertainty in declination","datatype":"DOUBLE","unit":"arcsec","ucd":"stat.error;pos.eq.dec"},{"name":"SpeakTot","description":"Integrated Stokes I flux density at 144MHz","datatype":"DOUBLE","unit":"mJy","ucd":"phot.flux.density;em.radio.100-200MHz"},{"name":"e_SpeakTot","description":"Uncertainty in integrated Stokes I flux density","datatype":"DOUBLE","unit":"mJy","ucd":"stat.error"},{"name":"Speak","description":"Peak Stokes I flux density at 144MHz per beam of the source","datatype":"DOUBLE","unit":"mJy/beam","ucd":"phot.flux.density;em.radio.100-200MHz"},{"name":"e_Speak","description":"Uncertainty in peak Stokes I flux density per beam of the source","datatype":"DOUBLE","unit":"mJy/beam","ucd":"stat.error"},{"name":"Maj","description":"? Fitted FWHM of the major axis of the source","datatype":"DOUBLE","unit":"arcsec","ucd":"phys.angSize"},{"name":"Min","description":"? Fitted FWHM of the minor axis of the source","datatype":"DOUBLE","unit":"arcsec","ucd":"phys.angSize;src"},{"name":"SCode","description":"Source classification code (1)","datatype":"CHAR","arraysize":"1","ucd":"meta.code"},{"name":"Res","description":"The angular resolution of the mosaic image from which the source was extracted","datatype":"SHORT","ucd":"pos.angResolution"},{"name":"match_dist","datatype":"DOUBLE"}],"data":[]}