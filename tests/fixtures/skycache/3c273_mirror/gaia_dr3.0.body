				</feature>
			</languageFeatures>
			<languageFeatures type="ivo://ivoa.net/std/tapregext#features-adql-offset">
				<feature>
					<form>OFFSET</form>
				</feature>
			</languageFeatures>
			<languageFeatures type="ivo://ivoa.net/std/tapregext#features-adql-conditional">
