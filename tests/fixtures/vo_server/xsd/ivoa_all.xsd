<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-only wrapper: imports the official IVOA schemas (downloaded 2026-09-28 from
     https://www.ivoa.net/xml/...; stc-v1.30.xsd from http://www.ivoa.net/xml/STC/) so that
     one lxml XMLSchema validates VOTable 1.4, VOSI 1.1, TAPRegExt 1.0, VODataService 1.1
     and UWS 1.1 documents. Their schemaLocation imports were rewritten to these local copies. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:all" elementFormDefault="qualified">
  <xs:import namespace="http://www.ivoa.net/xml/VOSICapabilities/v1.0" schemaLocation="VOSICapabilities-v1.0.xsd"/>
  <xs:import namespace="http://www.ivoa.net/xml/TAPRegExt/v1.0" schemaLocation="TAPRegExt-v1.0.xsd"/>
  <xs:import namespace="http://www.ivoa.net/xml/VODataService/v1.1" schemaLocation="VODataService-v1.1.xsd"/>
  <xs:import namespace="http://www.ivoa.net/xml/VOResource/v1.0" schemaLocation="VOResource-v1.1.xsd"/>
  <xs:import namespace="http://www.ivoa.net/xml/VOSITables/v1.0" schemaLocation="VOSITables-v1.1.xsd"/>
  <xs:import namespace="http://www.ivoa.net/xml/VOSIAvailability/v1.0" schemaLocation="VOSIAvailability-v1.0.xsd"/>
  <xs:import namespace="http://www.ivoa.net/xml/UWS/v1.0" schemaLocation="UWS-v1.1.xsd"/>
  <xs:import namespace="http://www.ivoa.net/xml/VOTable/v1.3" schemaLocation="VOTable-1.4.xsd"/>
</xs:schema>
