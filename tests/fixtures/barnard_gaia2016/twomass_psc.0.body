      <FIELD name="ra" datatype="double" ID="col_1" irsa_format="10.6f" precision="F6" ucd="pos.eq.ra;meta.main" unit="deg">
        <DESCRIPTION>right ascension (J2000 decimal deg)</DESCRIPTION>
      </FIELD>
      <FIELD name="dec" datatype="double" ID="col_2" irsa_format="10.6f" precision="F6" ucd="pos.eq.dec;meta.main" unit="deg">
        <DESCRIPTION>declination (J2000 decimal deg)</DESCRIPTION>
      </FIELD>
      <FIELD name="err_maj" datatype="float" ID="col_3" irsa_format="4.2f" precision="F2" unit="arcsec">
        <DESCRIPTION>Semi-major axis length of the one sigma position uncertainty ellipse</DESCRIPTION>
      </FIELD>
      <FIELD name="err_min" datatype="float" ID="col_4" irsa_format="4.2f" precision="F2" unit="arcsec">
        <DESCRIPTION>Semi-minor axis length of the one sigma position uncertainty ellipse</DESCRIPTION>
      </FIELD>
      <FIELD name="err_ang" datatype="int" ID="col_5" unit="deg">
        <DESCRIPTION>angle of error ellipse major axis (E of N)</DESCRIPTION>
      </FIELD>
      <FIELD name="j_m" datatype="float" ID="col_6" irsa_format="6.3f" precision="F3" ucd="phot.mag;em.IR.J" unit="mag">
        <DESCRIPTION>J band selected &quot;default&quot; magnitude</DESCRIPTION>
      </FIELD>
      <FIELD name="j_msigcom" datatype="float" ID="col_7" irsa_format="5.3f" precision="F3" unit="mag">
        <DESCRIPTION>combined (total) J band photometric uncertainty</DESCRIPTION>
      </FIELD>
      <FIELD name="h_m" datatype="float" ID="col_8" irsa_format="6.3f" precision="F3" ucd="phot.mag;em.IR.H" unit="mag">
