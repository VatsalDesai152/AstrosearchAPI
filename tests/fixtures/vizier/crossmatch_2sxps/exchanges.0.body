{"metadata":[{"name":"2SXPS","description":"Numerical unique source identifier within 2SXPS (2SXPS_ID)","datatype":"INT","ucd":"meta.id;meta.main"},{"name":"RAJ2000","description":"Right Ascension (J2000) (RA)","datatype":"DOUBLE","unit":"deg","ucd":"pos.eq.ra;meta.main"},{"name":"DEJ2000","description":"Declination (J2000) (Decl)","datatype":"DOUBLE","unit":"deg","ucd":"pos.eq.dec;meta.main"},{"name":"Err90","description":"Position uncertainty, 90% confidence, radial, assumed to be Rayleigh-distributed (Err90)","datatype":"DOUBLE","unit":"arcsec","ucd":"stat.error"},{"name":"IAUName","description":"IAU-format name, 2SXPS JHHMMSS+-ddmmsss (IAUName)","datatype":"CHAR","arraysize":"22","ucd":"meta.id"},{"name":"Det","description":"? The final source detection flag (DetFlag) (3)","datatype":"SHORT","ucd":"meta.code.error;phys.atmol.final"},{"name":"CR0","description":"? The mean count-rate in the 0.3-10keV band (Rate_band0)","datatype":"FLOAT","unit":"ct/s","ucd":"phot.count;em.X-ray"},{"name":"E_CR0","description":"? The 1-sigma positive uncertainty on the mean count-rate in the 0.3-10keV band (Rate_band0_pos)","datatype":"FLOAT","unit":"ct/s","ucd":"stat.error;stat.max"},{"name":"e_CR0","description":"[]? The 1-sigma negative uncertainty on the mean count-rate in the 0.3-10keV band (Rate_band0_neg)","datatype":"FLOAT","unit":"ct/s","ucd":"stat.error"},{"name":"HR1","description":"? The aggregate HR1 hardness ratio of the source (HR1)","datatype":"DOUBLE","ucd":"phot.flux;arith.ratio"},{"name":"HR2","description":"? The aggregate HR2 hardness ratio of the source (HR2)","datatype":"DOUBLE","ucd":"phot.flux;arith.ratio"},{"name":"PcstS0","description":"? The probability that the source count-rate in the 0.3-10keV band does not vary between snapshots (PvarPchiSnapshot_band0) (6)","datatype":"FLOAT","ucd":"src.var.index"},{"name":"FPO0","description":"? The mean 0.3-10keV observed flux assuming a power-law spectrum (PowFlux)","datatype":"FLOAT","unit":"mW.m**-2","ucd":"phot.flux;em.X-ray"},{"name":"FPU0","description":"The mean 0.3-10keV unabsorbed flux assuming a power-law spectrum (PowUnabsFlux)","datatype":"CHAR","arraysize":"9","unit":"mW.m**-2","ucd":"phot.flux;em.X-ray"},{"name":"match_dist","datatype":"DOUBLE"}],"data":[[13814,187.2779,2.05239,0.9,"2SXPS J122906.6+020308",0,4.73,0.0079,-0.0079,0.098,-0.078,0,2.224E-10," 2.22e-10",1.6027697155675624E-5]]}