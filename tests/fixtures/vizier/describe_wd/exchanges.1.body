] Uncertainty flag on Vmag","","meta.code.error","CHAR(1)",0,0],["\"n_Vmag\"","[pgBv ] v = multichannel V, pg = photographic, B = Johnson B","","meta.note","CHAR(2)",0,0],["\"B-V\"","[-0.7/2]? B-V color index in the UBV system","mag","phot.color;em.opt.B;em.opt.V","DOUBLE",0,0],["\"u_B-V\"","Uncertainty flag (:) on B-V color index","","meta.code.error;phot.color;em.opt.B;","CHAR(1)",0,0],["\"col\"","Color class from Lowell or Luyten PM surveys","","src.class.color","CHAR(3)",0,0],["\"U-B\"","[-9.9/1.4]? U-B color index in the UBV system","mag","phot.color;em.opt.U;em.opt.B","DOUBLE",0,0],["\"u_U-B\"","Uncertainty flag (:) on U-B color index","","meta.code.error;phot.color;em.opt.U;","CHAR(1)",0,0],["\"r_Vmag\"","Wide band photometry reference code","","meta.ref;pos.frame","CHAR(2)",0,0],["\"M2\"","[NACU] Modifications of UBV magnitudes (6)","","meta.note","CHAR(1)",0,0],["\"Vsphot\"","[9.5/20.1]? V mag from multichannel spectrophotometry","mag","phot.mag;em.opt.V","DOUBLE",0,0],["\"(g-r)\"","[-1.3/2.8]? g-r color index from spectrophotometry","mag","phot.color;em.opt.V;em.opt.R","DOUBLE",0,0],["\"u_(g-r)\"","Uncertainty flag (:) on g-r","","meta.code.error","CHAR(1)",0,0],["\"r_Vsphot\"","Multichannel spectrophotometry reference code","","meta.ref;pos.frame","CHAR(2)",0,0],["\"M3\"","[N] Modifications of Vsphot (6)","","meta.note","CHAR(1)",0,0],["\"ymag\"","[9.5/17.3]? y mag from ubvy photoelectric observations","mag","phot.mag;em.opt.V","DOUBLE",0,0],["\"b-y\"","[-0.4/0.8]? b-y color index from uvby","mag","phot.color;em.opt.B;em.opt.V","DOUBLE",0,0],["\"u_b-y\"","Uncertainty flag (:) on b-y","","meta.code.error;phot.color;em.opt.B;","CHAR(1)",0,0],["\"u-b\"","[-0.6/2]? u-b color index from uvby","mag","phot.color;em.opt.U;em.opt.B","DOUBLE",0,0],["\"r_ymag\"","uvby photoelectric photometry reference code","","meta.ref;pos.frame","CHAR(2)",0,0],["\"M4\"","[NCU] Modifications of uvby photometry (6)","","meta.note","CHAR(1)",0,0],["\"AbsMag\"","[-0.2/18.1]? Absolute