{"metadata":[{"name":"ObjectId","description":"Global unique object ID in the master table (object_id)","datatype":"LONG","ucd":"meta.id;meta.main"},{"name":"RAICRS","description":"Mean ICRS Right Ascension of the object (ICRS, Ep=J2000) (raj2000)","datatype":"DOUBLE","unit":"deg","ucd":"pos.eq.ra;meta.main"},{"name":"DEICRS","description":"Mean ICRS Declination of the object (ICRS, Ep=J2000) (dej2000)","datatype":"DOUBLE","unit":"deg","ucd":"pos.eq.dec;meta.main"},{"name":"EpMean","description":"Mean MJD epoch of the observations (mean_epoch)","datatype":"DOUBLE","unit":"d","ucd":"time.epoch;stat.mean"},{"name":"SMSS","description":"SkyMapper Southern Survey designation of the form SMSS Jhhmmss.ss+/-ddmmss.s derived from mean ICRS coordinates (smss_j)","datatype":"CHAR","arraysize":"18","ucd":"meta.id"},{"name":"e_RAICRS","description":"RMS variation around the mean Right Ascension (e_raj2000)","datatype":"SHORT","unit":"mas","ucd":"stat.stdev;pos.eq.ra"},{"name":"e_DEICRS","description":"RMS variation around the mean Declination (e_dej2000)","datatype":"SHORT","unit":"mas","ucd":"stat.stdev;pos.eq.dec"},{"name":"flags","description":"Bitwise OR of Source Extractor flags across all observations (flags)","datatype":"INT","ucd":"meta.code"},{"name":"ClassStar","description":"Maximum stellarity index from photometry table (between 0=no star and 1=star) (class_star)","datatype":"FLOAT","ucd":"src.class.starGalaxy;stat.max"},{"name":"RadrPetro","description":"? Mean r-band Petrosian radius (radius_petro)","datatype":"FLOAT","unit":"pix","ucd":"phys.angSize;stat.mean"},{"name":"uPSF","description":"? Weighted mean u-band PSF magnitude (u_psf)","datatype":"FLOAT","unit":"mag","ucd":"phot.mag;stat.mean"},{"name":"uPetro","description":"? Weighted mean u-band Petrosian magnitude (u_petro)","datatype":"FLOAT","unit":"mag","ucd":"phot.mag;stat.mean"},{"name":"vPSF","description":"? Weighted mean v-band PSF magnitude (v_psf)","datatype":"FLOAT","unit":"mag","ucd":"phot.mag;sta