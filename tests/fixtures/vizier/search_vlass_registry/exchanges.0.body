<?xml version='1.0' encoding='utf-8'?>
<VOTABLE version="1.5" xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://vo.ari.uni-heidelberg.de/docs/schemata/VOTable.xsd"><RESOURCE type="results"><INFO name="sql_query" value="SELECT r.ivoid, r.res_title, r.short_name, r.waveband, r.reference_url, c.standard_id, i.access_url FROM rr.resource AS r NATURAL JOIN rr.capability AS c  NATURAL JOIN rr.interface AS i  WHERE c.standard_id IN ( 'ivo://ivoa.net/std/conesearch' , 'ivo://ivoa.net/std/tap' ) AND i.intf_role = 'std' AND ( (to_tsvector('english', r.res_description) @@ plainto_tsquery('english', 'VLASS')) OR (to_tsvector('english', r.res_title) @@ plainto_tsquery('english', 'VLASS')) ) ORDER BY r.ivoid LIMIT 200">ADQL query translated to local SQL (for debugging)</INFO><INFO name="query" value="SELECT TOP 200 r.ivoid, r.res_title, r.short_name, r.waveband, r.reference_url, c.standard_id, i.access_url FROM rr.resource AS r NATURAL JOIN rr.capability AS c NATURAL JOIN rr.interface AS i WHERE c.standard_id IN ('ivo://ivoa.net/std/conesearch', 'ivo://ivoa.net/std/tap') AND i.intf_role = 'std' AND (1 = ivo_hasword(r.res_description, 'VLASS') OR 1 = ivo_hasword(r.res_title, 'VLASS')) ORDER BY r.ivoid">Original ADQL query</INFO><INFO name="QUERY_STATUS" value="OK">Query successful</INFO><INFO name="server_software" value="DaCHS/2.13.3 twistedWeb/22.4.0">Software that produced this VOTable</INFO><INFO name="server" value="http://voparis-rr.obspm.fr">Base URI of the server</INFO><INFO name="citation" ucd="" value="http://voparis-rr.obspm.fr/__system__/tap/run/howtocite">Advice on citing this resource</INFO><INFO name="citation" ucd="" value="http://voparis-rr.obspm.fr/tableinfo/rr.resource#ti-citing">Advice on citing this resource</INFO><INFO name="citation" ucd="" value="http://voparis-rr.obspm.fr/tableinfo/rr.interface#ti-citing">Advice on citing this resource</INFO><INFO name="citation" ucd="" value="http://voparis-rr.obspm.fr/tableinfo/rr.capability#ti-citing">Advice on citing this resource</INFO><INFO name="ivoid_service" ucd="meta.ref.ivoid" value="ivo://padc.obspm.voparis-rr/tap">Originating VO service</INFO><INFO name="publisher" value="Paris Astronomical Data Centre">Data centre that has delivered the data</INFO><INFO name="request_date" ucd="time.creation" value="2026-09-29T03:46:51Z"></INFO><INFO name="contact" ucd="meta.email" value="vo.paris@obspm.fr">Contact option</INFO><INFO name="reference_url" ucd="meta.ref.url" value="http://voparis-rr.obspm.fr/__system__/tap/run/info">More information on the data Source</INFO><INFO name="reference_url" ucd="meta.ref.url" value="http://voparis-rr.obspm.fr/tableinfo/rr.resource">More information on the data Source</INFO><INFO name="reference_url" ucd="meta.ref.url" value="http://voparis-rr.obspm.fr/tableinfo/rr.interface">More information on the data Source</INFO><INFO name="reference_url" ucd="meta.ref.url" value="http://voparis-rr.obspm.fr/tableinfo/rr.capability">More information on the data Source</INFO><INFO name="creator" ucd="meta.bib.author" value="PADC">Name of a person or entity that produced a contributing resource</INFO><TABLE name="r_c_i"><GROUP ID="ndtpatueluea" name="note-w"><DESCRIPTION>
The allowed values for waveband include:
Radio, Millimeter, Infrared, Optical, UV, EUV, X-ray, Gamma-ray.</DESCRIPTION><FIELDref ref="waveband"/></GROUP><FIELD ID="ivoid" arraysize="*" datatype="char" name="ivoid" utype="xpath:identifier"><DESCRIPTION>Unambiguous reference to the resource conforming to the IVOA standard for identifiers.</DESCRIPTION></FIELD><FIELD ID="res_title" arraysize="*" datatype="unicodeChar" name="res_title" utype="xpath:title"><DESCRIPTION>The full name given to the resource.</DESCRIPTION></FIELD><FIELD ID="short_name" arraysize="*" datatype="char" name="short_name" utype="xpath:shortName"><DESCRIPTION>A short name or abbreviation given to something, for presentation in space-constrained fields (up to 16 characters).</DESCRIPTION></FIELD><FIELD ID="waveband" arraysize="*" datatype="char" name="waveband" utype="xpath:coverage/waveband"><DESCRIPTION>A hash-separated list of regions of the electro-magnetic spectrum that the resource's spectral coverage overlaps with.</DESCRIPTION></FIELD><FIELD ID="reference_url" arraysize="*" datatype="char" name="reference_url" utype="xpath:content/referenceURL"><DESCRIPTION>URL pointing to a human-readable document describing this resource.</DESCRIPTION></FIELD><FIELD ID="standard_id" arraysize="*" datatype="char" name="standard_id" utype="xpath:@standardID"><DESCRIPTION>A URI for a standard this capability conforms to.</DESCRIPTION></FIELD><FIELD ID="access_url" arraysize="*" datatype="char" name="access_url" utype="xpath:accessURL"><DESCRIPTION>The URL at which the interface is found.</DESCRIPTION></FIELD><DATA><BINARY><STREAM encoding="base64"></STREAM></BINARY></DATA></TABLE></RESOURCE></VOTABLE>