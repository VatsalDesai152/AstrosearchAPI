      <DESCRIPTION>[CV] Whether the source comes from a coadd or visit (corv)</DESCRIPTION>
    </FIELD>
    <FIELD name="G" ucd="meta.note" display="0" datatype="short" width="2"><!-- ucd="NOTE" -->
      <DESCRIPTION>[-1/1] Neighbours rank (grank) (1)</DESCRIPTION>
    </FIELD>
    <FIELD name="N" ucd="meta.number" display="0" datatype="short" width="2"><!-- ucd="NUMBER" -->
      <DESCRIPTION>[1/12] Number of sources within 2.5", if this is a primary (ngrank)</DESCRIPTION>
    </FIELD>
    <FIELD name="primid" ucd="meta.id.assoc" display="0" datatype="long" width="19"><!-- ucd="ID_ASSOCIATED" -->
      <DESCRIPTION>objid of the primary (only of use for the "plus" catalog) (primgid)</DESCRIPTION>
    </FIELD>
    <FIELD name="groupid" ucd="meta.id.assoc" display="0" datatype="char" arraysize="239*"><!-- ucd="ID_ASSOCIATED" -->
      <DESCRIPTION>objid's of all sources (AIS) within 2.5", concatenated by "+" (groupgid)</DESCRIPTION>
    </FIELD>
    <FIELD name="Gd" ucd="meta.note" display="0" datatype="short" width="2"><!-- ucd="NOTE" -->
      <DESCRIPTION>[-1/1] as for "G" (grank), but based on distance criterion (grankdist) (1)</DESCRIPTION>
    </FIELD>
    <FIELD name="Nd" ucd="meta.number" display="0" datatype="short" width="2"><!-- ucd="NUMBER" -->
      <DESCRIPTION>[1/12] as for "N" (ngrank), but based on distance criterion (ngrankdist)</DESCRIPTION>
    </FIELD>
    <FIELD name="primidd" ucd="meta.id.assoc" display="0" datatype="long" width="19"><!-- ucd="ID_ASSOCIATED" -->
      <DESCRIPTION>objid of the closest primary, based on distance criterion (primgiddist)</DESCRIPTION>
    </FIELD>
    <FIELD name="groupidd" ucd="meta.id.assoc" display="0" datatype="char" arraysize="239*"><!-- ucd="ID_ASSOCIATED" -->
      <DESCRIPTION>objid's of all sources (AIS) within 2.5", based on distance criterion (groupgiddist)</DESCRIPTION>
    </FIELD>
    <FIELD name="groupTot" ucd="meta.id.assoc" display="0" datatype="char" arraysize="239*"><!-- ucd="ID_ASSOCIATED" -->
      <DESCRIPTION>objid's of all sources within 2.5" (groupgidtot)</DESCRIPTION>
    </FIELD>
    <FIELD name="OName" ucd="meta.id.assoc" display="0" datatype="char" arraysize="31*"><!-- ucd="ID_ASSOCIATED" -->
      <DESCRIPTION>Extended object? (if not: "N") (inlargeobj) (2)</DESCRIPTION>
    </FIELD>
    <FIELD name="Size" ucd="phys.angSize" display="0" datatype="double" width="8" precision="2" unit="pix"><!-- ucd="EXTENSION_DIAM" -->
      <DESCRIPTION>[/38740]? Size of the extended object (largeobjsize) (3)</DESCRIPTION>
      <VALUES null="NaN" />
    </FIELD>
  </TABLE>
<INFO name="matches" value="2">matching records</INFO>
</RESOURCE>
</VOTABLE>
