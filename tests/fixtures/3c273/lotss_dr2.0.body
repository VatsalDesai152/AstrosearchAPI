{"metadata":[{"name":"Source","description":"The radio name of the source, automatically generated from RA and DEC (Source_Name)","datatype":"CHAR","arraysize":"22","ucd":"meta.id;meta.main"},{"name":"RAJ2000","description":"Right ascension (J2000) (RA) (1)","datatype":"DOUBLE","unit":"deg","ucd":"pos.eq.ra;meta.main"},{"name":"DEJ2000","description":"Declination (J2000) (DEC) (1)","datatype":"DOUBLE","unit":"deg","ucd":"pos.eq.dec;meta.main"},{"name":"e_RAJ2000","description":"rms uncertainty on RA (E_RA) (2)","datatype":"DOUBLE","unit":"arcsec","ucd":"stat.error;pos.eq.ra"},{"name":"e_DEJ2000","description":"rms uncertainty on DE (E_DEC) (2)","datatype":"DOUBLE","unit":"arcsec","ucd":"stat.error;pos.eq.dec"},{"name":"SpeakTot","description":"The total, integrated Stokes I flux density of the source at the reference frequency (Total_flux)","datatype":"DOUBLE","unit":"mJy","ucd":"phot.flux.density;em.radio.100-200MHz"},{"name":"e_SpeakTot","description":"The 1-sigma error on the total flux density of the source (E_Total_flux)","datatype":"DOUBLE","unit":"mJy","ucd":"stat.error"},{"name":"Maj","description":"FWHM of the major axis of the source, INCLUDING convolution with the 6-arcsec LOFAR beam (Maj)","datatype":"DOUBLE","unit":"arcsec","ucd":"phys.angSize"},{"name":"Min","description":"FWHM of the minor axis of the source, INCLUDING convolution with the 6-arcsec LOFAR beam (Min)","datatype":"DOUBLE","unit":"arcsec","ucd":"phys.angSize;src"},{"name":"SCode","description":"A code that defines the source structure in terms of the fitted Gaussian components (S_Code) (3)","datatype":"CHAR","arraysize":"1","ucd":"meta.code"},{"name":"match_dist","datatype":"DOUBLE"}],"data":[]}