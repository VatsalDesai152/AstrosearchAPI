  {
    "TableName": "SqlQuery",
    "Rows": [
      {
        "query": "SELECT TOP 3 CAST(n.objID AS VARCHAR(24)) AS objID, n.distance*60.0 AS dist_arcsec, pz.z, pz.zErr, pz.photoErrorClass, pz.nnCount FROM dbo.fGetNearbyObjEq(233.738433167, 23.503224556, 0.0333333333) AS n JOIN PhotoPrimary AS p ON p.objID = n.objID JOIN Photoz AS pz ON pz.objID = n.objID ORDER BY n.distance"
      }
    ]
  }
]