  {
    "TableName": "SqlQuery",
    "Rows": [
      {
        "query": "SELECT TOP 5 CAST(n.specObjID AS VARCHAR(24)) AS specObjID, n.distance*60.0 AS dist_arcsec, s.ra, s.dec, s.z, s.zErr, s.zWarning, s.class, s.subClass, s.survey, s.sciencePrimary FROM dbo.fGetNearbySpecObjEq(233.738433167, 23.503224556, 0.0333333333) AS n JOIN SpecObj AS s ON s.specObjID = n.specObjID ORDER BY s.sciencePrimary DESC, n.distance"
      }
    ]
  }
