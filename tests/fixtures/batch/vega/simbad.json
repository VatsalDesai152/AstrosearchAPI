  "strategy": "upload",
  "exchanges": [
    {
      "method": "POST",
      "url": "https://simbad.cds.unistra.fr/simbad/sim-tap/sync",
      "request_content_type": "multipart/form-data",
      "fields": {
        "REQUEST": "doQuery",
        "LANG": "ADQL",
        "QUERY": "SELECT tu.t_idx, b.main_id, b.ra, b.dec, b.coo_err_maj, b.coo_err_min, b.coo_err_angle, b.coo_qual, b.coo_wavelength, b.coo_bibcode, b.otype, b.sp_type, b.rvz_redshift, b.plx_value, b.pmra, b.pmdec, f.V, f.G, f.K FROM basic AS b LEFT OUTER JOIN allfluxes AS f ON f.oidref = b.oid, TAP_UPLOAD.targets AS tu WHERE 1 = CONTAINS(POINT('ICRS', b.ra, b.dec), CIRCLE('ICRS', tu.t_ra, tu.t_dec, tu.t_rad))",
        "UPLOAD": "targets,param:targets",
        "MAXREC": "200000",
        "FORMAT": "json",
        "targets": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<VOTABLE version=\"1.3\" xmlns=\"http://www.ivoa.net/xml/VOTable/v1.3\">\n<RESOURCE type=\"results\"><TABLE name=\"targets\">\n<FIELD name=\"t_idx\" datatype=\"int\"/>\n<FIELD name=\"t_ra\" datatype=\"double\" unit=\"deg\"/>\n<FIELD name=\"t_dec\" datatype=\"double\" unit=\"deg\"/>\n<FIELD name=\"t_rad\" datatype=\"double\" unit=\"deg\"/>\n<DATA><TABLEDATA>\n<TR><TD>0</TD><TD>279.23473479</TD><TD>38.78368896</TD><TD>0.001388888888888889</TD></TR>\n<TR><TD>1</TD><TD>279.23473479</TD><TD>38.800355626666665</TD><TD>0.001388888888888889</TD></TR>\n</TABLEDATA></DATA></TABLE></RESOURCE></VOTABLE>\n"
      },
      "request_body": "",
      "status_code": 200,
      "content_type": "application/json;charset=UTF-8"
    }
  ]
}