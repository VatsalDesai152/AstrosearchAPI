      <FIELD name="designation" datatype="char" arraysize="*" ID="col_1" ucd="meta.id;meta.main">
        <DESCRIPTION>source designation formed from sexigesimal coordinates</DESCRIPTION>
      </FIELD>
      <FIELD name="ra" datatype="double" ID="col_2" irsa_format="10.6f" precision="F6" ucd="pos.eq.ra;meta.main" unit="deg">
        <DESCRIPTION>right ascension (J2000 decimal deg)</DESCRIPTION>
      </FIELD>
      <FIELD name="dec" datatype="double" ID="col_3" irsa_format="10.6f" precision="F6" ucd="pos.eq.dec;meta.main" unit="deg">
        <DESCRIPTION>declination (J2000 decimal deg)</DESCRIPTION>
      </FIELD>
      <FIELD name="err_maj" datatype="float" ID="col_4" irsa_format="4.2f" precision="F2" unit="arcsec">
        <DESCRIPTION>Semi-major axis length of the one sigma position uncertainty ellipse</DESCRIPTION>
      </FIELD>
      <FIELD name="err_min" datatype="float" ID="col_5" irsa_format="4.2f" precision="F2" unit="arcsec">
        <DESCRIPTION>Semi-minor axis length of the one sigma position uncertainty ellipse</DESCRIPTION>
      </FIELD>
      <FIELD name="err_ang" datatype="int" ID="col_6" unit="deg">
        <DESCRIPTION>angle of error ellipse major axis (E of N)</DESCRIPTION>
      </FIELD>
      <FIELD name="j_m" datatype="float" ID="col_7" irsa_format="6.3f" precision="F3" ucd="phot.mag;em.IR.J" unit="mag">
        <DESCRIPTION>J band selected &quot;default&quot; magnitude</DESCRIPTION>
      </FIELD>
      <FIELD name="j_msigcom" datatype="float" ID="col_8" irsa_format="5.3f" precision="F3" unit="mag">
        <DESCRIPTION>combined (total) J band photometric uncertainty</DESCRIPTION>
      </FIELD>
      <FIELD name="h_m" datatype="float" ID="col_9" irsa_format="6.3f" precision="F3" ucd="phot.mag;em.IR.H" unit="mag">
        <DESCRIPTION>H band selected &quot;default&quot; magnitude</DESCRIPTION>
      </FIELD>
      <FIELD name="h_msigcom" datatype="float" ID="col_10" irsa_format="5.3f" precision="F3" unit="mag">
        <DESCRIPTION>combined (total) H band photometric uncertainty</DESCRIPTION>
      </FIELD>
      <FIELD name="k_m" datatype="float" ID="col_11" irsa_format="6.3f" precision="F3" ucd="phot.mag;em.IR.K" unit="mag">
        <DESCRIPTION>K band selected &quot;default&quot; magnitude</DESCRIPTION>
      </FIELD>
      <FIELD name="k_msigcom" datatype="float" ID="col_12" irsa_format="5.3f" precision="F3" unit="mag">
        <DESCRIPTION>combined (total) K band photometric uncertainty</DESCRIPTION>
      </FIELD>
      <FIELD name="ph_qual" datatype="char" arraysize="*" ID="col_13" ucd="meta.code.qual">
        <DESCRIPTION>flag indicating photometric quality of source</DESCRIPTION>
      </FIELD>
      <FIELD name="cc_flg" datatype="char" arraysize="*" ID="col_14">
        <DESCRIPTION>indicates JHK artifact contamination and/or confusion</DESCRIPTION>
      </FIELD>
      <FIELD name="ext_key" datatype="long" ID="col_15">
        <DESCRIPTION>key to extended source data DB record</DESCRIPTION>
      </FIELD>
      <FIELD name="jdate" datatype="double" ID="col_16" irsa_format="12.4f" precision="F4" ucd="time;obs.exposure" unit="d">
