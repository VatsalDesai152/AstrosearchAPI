<?xml version="1.0"?>
<VOTABLE xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.4">
 <RESOURCE type="results">
  <INFO name="QUERY_STATUS" value="OK">No errors detected in query preprocessing</INFO>
  <TABLE>
   <DESCRIPTION>Query result for:&#xA;SELECT TOP 201 name, ra, dec, error_ellipse_r0, error_ellipse_r1, error_ellipse_angle, significance, b_flux_ap, b_flux_ap_lo, b_flux_ap_hi, hardness_ratio_hs, hardness_ratio_hm, var_flag, conf_flag, extent_flag, sat_src_flag, pileup_flag, acis_num, hrc_num, DISTANCE(POINT(&apos;ICRS&apos;, ra, dec), POINT(&apos;ICRS&apos;, 187.705930800, 12.391123300)) AS match_dist FROM csc WHERE 1 = CONTAINS(POINT(&apos;ICRS&apos;, ra, dec), CIRCLE(&apos;ICRS&apos;, 187.705930800, 12.391123300, 0.0027777778)) ORDER BY match_dist ASC</DESCRIPTION>
   <FIELD datatype="char" arraysize="*" ucd="meta.id;meta.main" name="name">
    <DESCRIPTION>Source Designation (2CXO JHHMMSS.SsDDMMSS[X])</DESCRIPTION>
   </FIELD>
   <FIELD unit="deg" datatype="double" ucd="pos.eq.ra;meta.main" precision="F6" name="ra">
    <DESCRIPTION>Right Ascension</DESCRIPTION>
   </FIELD>
   <FIELD unit="deg" datatype="double" ucd="pos.eq.dec;meta.main" precision="F6" name="dec">
    <DESCRIPTION>Declination</DESCRIPTION>
   </FIELD>
   <FIELD unit="arcsec" datatype="double" ucd="phys.angSize.smajAxis;pos.errorEllipse" precision="F5" name="error_ellipse_r0" width="7">
    <DESCRIPTION>Major Radius of the 95% Confidence Level Position Error Ellipse</DESCRIPTION>
   </FIELD>
   <FIELD unit="arcsec" datatype="double" ucd="phys.angSize.sminAxis;pos.errorEllipse" precision="F5" name="error_ellipse_r1" width="7">
    <DESCRIPTION>Minor Radius of the 95% Confidence Level Position Error Ellipse</DESCRIPTION>
   </FIELD>
   <FIELD unit="deg" datatype="double" ucd="pos.posAng;pos.errorEllipse" precision="F3" name="error_ellipse_angle" width="7">
    <DESCRIPTION>Position Angle of the Major Axis of the 95% Confidence Level Error Ellipse</DESCRIPTION>
   </FIELD>
   <FIELD datatype="double" ucd="stat.snr" precision="E3" name="significance">
    <DESCRIPTION>Highest Source Signal-to-Noise Ratio Across All Stacked Obs. and Energy Bands</DESCRIPTION>
   </FIELD>
   <FIELD unit="erg/s/cm^2" datatype="double" ucd="phot.flux;src.net;em.X-ray" precision="E2" name="b_flux_ap">
    <DESCRIPTION>Net Energy Flux from Source Region Aperture, Bayesian Analysis; ACIS Broad Band</DESCRIPTION>
   </FIELD>
   <FIELD unit="erg/s/cm^2" datatype="float" ucd="stat.error;phot.flux;src.net;stat.min;em.X-ray" precision="E2" name="b_flux_ap_lo">
    <DESCRIPTION>Net Energy Flux from Source Region Aperture (68% Lower Limit); ACIS Broad Band</DESCRIPTION>
   </FIELD>
   <FIELD unit="erg/s/cm^2" datatype="float" ucd="stat.error;phot.flux;src.net;stat.max;em.X-ray" precision="E2" name="b_flux_ap_hi">
    <DESCRIPTION>Net Energy Flux from Source Region Aperture (68% Upper Limit); ACIS Broad Band</DESCRIPTION>
   </FIELD>
   <FIELD datatype="double" ucd="phot.color;em.X-ray" precision="E2" name="hardness_ratio_hs">
    <DESCRIPTION>ACIS Hard - Soft Hardness Ratio</DESCRIPTION>
   </FIELD>
   <FIELD datatype="double" ucd="phot.color;em.X-ray" precision="E2" name="hardness_ratio_hm">
    <DESCRIPTION>ACIS Hard - Medium Band Hardness Ratio</DESCRIPTION>
   </FIELD>
   <FIELD datatype="char" arraysize="*" ucd="meta.code;src.var" name="var_flag">
    <DESCRIPTION>Flag Indicates Source Displays Flux Variability</DESCRIPTION>
   </FIELD>
   <FIELD datatype="char" arraysize="*" ucd="meta.code" name="conf_flag">
    <DESCRIPTION>Flag Indicates Source Regions Overlap (Confused Source)</DESCRIPTION>
   </FIELD>
   <FIELD datatype="char" arraysize="*" ucd="meta.code;phys.angSize" name="extent_flag">
    <DESCRIPTION>Flag Indicates Source Extent Inconsistent with Point Source (90% Confidence)</DESCRIPTION>
   </FIELD>
   <FIELD datatype="char" arraysize="*" ucd="meta.code.qual;instr.saturation" name="sat_src_flag">
    <DESCRIPTION>Flag Indicates Source Saturated in All Observations</DESCRIPTION>
   </FIELD>
   <FIELD datatype="char" arraysize="*" ucd="meta.code" name="pileup_flag">
    <DESCRIPTION>Flag Indicates ACIS Pile-Up Fraction Exceeds ~10% in All Observations</DESCRIPTION>
   </FIELD>
   <FIELD datatype="short" ucd="meta.number" name="acis_num">
    <DESCRIPTION>Total Number of ACIS Imaging Observations Contributing to Master Source Record</DESCRIPTION>
    <VALUES null="-32768"/>
   </FIELD>
   <FIELD datatype="short" ucd="meta.number" name="hrc_num">
    <DESCRIPTION>Total Number of HRC Imaging Observations Contributing to Master Source Record</DESCRIPTION>
    <VALUES null="-32768"/>
   </FIELD>
   <FIELD datatype="double" name="match_dist"/>
