# AstroSearch configuration. Every value below is the default unless marked "example";
# see DOCUMENTATION.md section 9 for the full list. Nothing reads this file automatically:
# export the variables, or pass it to your process manager / container (docker --env-file).

# --- Core -------------------------------------------------------------------------------
LOG_LEVEL=INFO
DEFAULT_RADIUS_ARCSEC=3.0
# HTTP client timeout (default 30 s). Setting it ALSO caps every catalog's own timeout (Gaia,
# 2MASS and AllWISE use 90 s, NED/SDSS/VLASS 60 s): leave it unset unless you want that.
# REQUEST_TIMEOUT_SECONDS=30.0
# example: cap every catalog's own timeout
# CATALOG_TIMEOUT_CAP_SECONDS=60
MAX_RESPONSE_BYTES=10000000
SESAME_ENDPOINT=https://cds.unistra.fr/cgi-bin/nph-sesame/-oxp/SNV
# User catalog registry written by `astrosearch vizier add` (default ~/.astrosearch/catalogs.yaml)
# CATALOG_REGISTRY_PATH=/srv/astrosearch/catalogs.yaml
CATALOG_REGISTRY_STRICT=false

# --- API --------------------------------------------------------------------------------
# example; empty = no authentication
API_KEYS=local-dev-key
REQUIRE_API_KEY=false
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
API_RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=1048576
API_MAX_BATCH_SIZE=100
API_MAX_TARGETS=10000
API_SEARCH_CACHE_TTL_SECONDS=300
CORS_ORIGINS=*
# only honoured with explicit origins
CORS_ALLOW_CREDENTIALS=true
UI_PUBLIC=true
# ASTROSEARCH_WEB_DIR=/srv/astrosearch/web

# --- Archive access ---------------------------------------------------------------------
PROVIDER_REQUESTS_PER_SECOND=5
PROVIDER_FAILURE_THRESHOLD=5
PROVIDER_RECOVERY_SECONDS=30
PROVIDER_PROBE_TIMEOUT_SECONDS=180
PROVIDER_CACHE_TTL_SECONDS=600
PROVIDER_CACHE_MAX_ENTRIES=512
# e.g. redis://localhost:6379/0 (cache, quotas, dataset jobs)
REDIS_URL=

# --- Datasets and storage ---------------------------------------------------------------
DATASET_STORAGE_PATH=datasets
DATABASE_URL=sqlite:///datasets/metadata.sqlite3
DATASET_BATCH_MIN_TARGETS=50
S3_BUCKET=
S3_ENDPOINT_URL=

# --- Batch crossmatch -------------------------------------------------------------------
BATCH_MAX_TARGETS=100000
BATCH_MAX_CATALOGS=20
BATCH_MAX_CONE_TARGETS=5000
BATCH_MAX_UPLOAD_BYTES=52428800
BATCH_UPLOAD_TIMEOUT_SECONDS=300
BATCH_CATALOG_BUDGET_SECONDS=1800

# --- Sky cache --------------------------------------------------------------------------
SKYCACHE_ENABLED=true
# default ~/.astrosearch/skycache
# SKYCACHE_PATH=/srv/astrosearch/skycache
SKYCACHE_TILE_ROWS=10000
SKYCACHE_MAX_RADIUS_DEG=1.0
SKYCACHE_MAX_QUERIES=256

# --- VizieR, SED, time domain, imaging --------------------------------------------------
# example: a VizieR mirror
# VIZIER_ASU_URL=http://vizier.nao.ac.jp/viz-bin/votable
ASTROSEARCH_SED_OFFLINE_FILTERS=false
# default ~/.cache/astrosearch
# ASTROSEARCH_CACHE_DIR=/srv/astrosearch/cache
TIMEDOMAIN_PERIOD_SEARCH_BUDGET_S=60
TIMEDOMAIN_ANALYSIS_WORKERS=2
# default <tmp>/astrosearch-cutouts
# CUTOUT_CACHE_DIR=/srv/astrosearch/cutouts

# --- VO services ------------------------------------------------------------------------
VO_TAP_DEFAULT_MAXREC=10000
VO_TAP_HARD_MAXREC=100000
VO_MAX_RESULT_BYTES=16000000
VO_UWS_MAX_STORED_BYTES=256000000

# --- Alerts -----------------------------------------------------------------------------
# default: the dataset metadata database
# ALERTS_DATABASE_URL=sqlite:///datasets/alerts.sqlite3

# Optional alert host-lookup recovery when TAPVizieR is unavailable
ASTROSEARCH_VIZIER_ASU_FALLBACK=false

# --- AI (Claude) ------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# ASTROSEARCH_AI_MODEL=claude-opus-5
# ADS_API_TOKEN=
