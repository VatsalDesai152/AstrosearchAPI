APP_NAME=astrosearch
DEBUG=false
DEFAULT_RADIUS_ARCSEC=3.0
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RESPONSE_BYTES=10000000
# Optional custom registry path (defaults to 16 definitions; 15 enabled)
CATALOG_REGISTRY_PATH=
LOG_LEVEL=INFO
SESAME_ENDPOINT=https://cds.unistra.fr/cgi-bin/nph-sesame/-oxp/SNV
DATASET_STORAGE_PATH=datasets
DATABASE_URL=sqlite:///datasets/metadata.sqlite3
REDIS_URL=
S3_BUCKET=
S3_ENDPOINT_URL=
API_KEYS=local-dev-key
# Optional signed bearer token validation (JWT)
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
REQUIRE_API_KEY=false
CORS_ORIGINS=*
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_BATCH_SIZE=100
API_MAX_TARGETS=1000
MAX_REQUEST_BYTES=1048576
PROVIDER_REQUESTS_PER_SECOND=1
PROVIDER_MAX_CONCURRENCY=2
PROVIDER_BURST=1
PROVIDER_BACKOFF_BASE=1
PROVIDER_BACKOFF_MAX=60
PROVIDER_LEASE_SECONDS=120
# Override any budget for an archive, for example PROVIDER_GAIA_MAX_CONCURRENCY=2
# Budget names: GAIA, MAST, IRSA, SDSS, HEASARC, SIMBAD, NED, EXOPLANET, VIZIER
PROVIDER_PRODUCT_MAX_BYTES=134217728
PROVIDER_FAILURE_THRESHOLD=5
PROVIDER_RECOVERY_SECONDS=30
PROVIDER_CACHE_TTL_SECONDS=600
# local: provider tasks run in-process; rq: archive:<provider> worker queues
DATASET_EXECUTION_MODE=local
DATASET_TASK_BATCH=16
DATASET_ENRICHMENT_BATCH=128
DATASET_TASK_ATTEMPTS=3
DATASET_MAX_ROUNDS=1000
DATASET_NO_PROGRESS_ROUNDS=25
DATASET_SHARD_TIMEOUT=600
DATASET_SHARD_WAIT_SECONDS=900
DATASET_SCAN_TTL_SECONDS=86400
# Automatic format selection and partition limits (bytes refer to JSONL spool estimates)
DATASET_PARQUET_ROWS=10000
DATASET_PARQUET_FIELDS=64
DATASET_PARQUET_BYTES=8388608
DATASET_PARTITION_ROWS=100000
DATASET_PARTITION_BYTES=67108864
# Persistent cache for MAST TESS SPOC FITS products
TESS_CACHE_DIR=
POSTGRES_PASSWORD=local-dev-postgres
MINIO_ROOT_USER=local-dev-minio
MINIO_ROOT_PASSWORD=local-dev-minio-password
